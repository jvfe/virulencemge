/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Input preparation
    //
    withName: GUNZIP {
        publishDir = [ enabled: false ]
    }

    withName: PREPARE_GENBANK {
        ext.prefix = { "${meta.id}_prepared" }
        publishDir = [
            path: { "${params.outdir}/prepared_genomes" },
            mode: params.publish_dir_mode,
            pattern: "*.{gbk,tsv}"
        ]
    }

    //
    // Virulence factor mining
    //
    withName: ABRICATE_RUN {
        ext.args = [
            "--db ${params.abricate_db}",
            "--minid ${params.abricate_minid}",
            "--mincov ${params.abricate_mincov}"
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/abricate" },
            mode: params.publish_dir_mode,
            pattern: "*.txt"
        ]
    }

    withName: ABRICATE_SUMMARY {
        publishDir = [
            path: { "${params.outdir}/abricate" },
            mode: params.publish_dir_mode,
            pattern: "*.txt"
        ]
    }

    //
    // Prophage identification
    //
    withName: PHISPY {
        ext.args = [
            "--output_choice ${params.phispy_output_choice}",
            "--phage_genes ${params.phispy_phage_genes}",
            params.phispy_training_set ? "--training_set ${params.phispy_training_set}" : ''
        ].join(' ').trim()
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/phispy" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,gff3,gbk,gbff,log,tbl}"
        ]
    }

    //
    // Genomic / pathogenicity island identification
    //
    // IslandPath-DIMOB always writes its log as `Dimob.log`, so every sample
    // would publish over the same file; `saveAs` renames it per sample instead.
    // This has to stay a single publishDir entry rather than a list of two,
    // because `nextflow config -o json` evaluates closures nested inside a list
    // and `meta` does not exist in that context.
    //
    withName: ISLANDPATH {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/islandpath" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'Dimob.log' ? "logs/${meta.id}_Dimob.log" : filename }
        ]
    }

    //
    // Coordinate integration and cross-referencing
    //
    withName: INTEGRATE_ELEMENTS {
        ext.args = "--min-overlap ${params.mge_min_overlap}"
        publishDir = [
            path: { "${params.outdir}/integrated_elements" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,bed,gff3}"
        ]
    }

    withName: SUMMARY_REPORT {
        ext.args = [
            "--top-genes ${params.report_top_genes}",
            "--min-overlap ${params.mge_min_overlap}"
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/summary_report" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,tsv}"
        ]
    }
}
