/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    pyrodigal / gene-caller-only annotation
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use with samplesheets that supply GenBank (+ optional FAA) from pyrodigal, Prodigal
    or any caller whose CDS features carry no functional product names.

    PhiSpy's default --phage_genes 1 requires at least one gene in a candidate region
    whose annotation looks phage-like. pyrodigal GenBank files have no /product
    qualifiers, so that filter drops almost every call. Setting phage_genes to 0 makes
    PhiSpy rely on the composition-based classifier alone, which is the intended mode
    for ab initio gene calls.

    Include from the command line (after base.config is loaded automatically):

        nextflow run ... -c conf/pyrodigal_phispy.config

    or combine with an institution / cluster config:

        nextflow run ... -profile singularity \\
            -c conf/pyrodigal_phispy.config \\
            -c conf/ufmt_beegfs.config
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'pyrodigal'
    config_profile_description = 'PhiSpy tuned for pyrodigal / gene-caller-only GenBank input'

    // Prophage identification (PhiSpy)
    // 0 = do not require phage-like gene annotations inside a candidate region
    phispy_phage_genes   = 0
    // null = PhiSpy container default training set (trainSet_genericAll.txt)
    phispy_training_set  = null
    /*
     * Bitwise output mask. 512 = all outputs (default in the pipeline).
     * Common lighter alternatives when disk space matters:
     *   1   = prophage_coordinates.tsv only (enough for integrate_elements)
     *   513 = coordinates + prophage_information.tsv (coordinates + per-gene scores for QC)
     */
    phispy_output_choice = 512
}

process {
    // PhiSpy runs a random forest over every gene on every contig; bacterial chromosomes
    // benefit from the medium label plus a few extra cores.
    withName: PHISPY {
        cpus   = { 4 * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}
