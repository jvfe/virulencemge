/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    UFMT / beegfs scratch layout (optional)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Keeps Nextflow work directories and Singularity caches on beegfs scratch rather
    than $HOME. Uncomment the executor block if you submit through Slurm; queue and
    account names vary by site so they are left as placeholders.
----------------------------------------------------------------------------------------
*/

// Default work directory when -work-dir is not passed on the CLI
workDir = "${System.getenv('NXF_WORK_DIR') ?: "/mnt/beegfs/scratch/${System.getenv('USER')}/nextflow-work/virulencemge"}"

// Read/write heavy inputs and outputs already live on beegfs in the samplesheet;
// stageInMode = 'copy' avoids symlink issues when compute nodes cannot see login paths.
process {
    stageInMode  = 'copy'
    stageOutMode = 'copy'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "/mnt/beegfs/scratch/${System.getenv('USER')}/singularity_cache"}"
}

/*
executor {
    name          = 'slurm'
    queueSize     = 100
    submitRateLimit = '10/1min'
}

process {
    executor = 'slurm'
    queue    = 'YOUR_PARTITION'
    clusterOptions = '--account=YOUR_ACCOUNT'
}
*/
